os.Exit(1)
}
input = string(bytes)
} else {
bytes, err := os.ReadFile(args[0])
if err != nil {
fmt.Fprintln(os.Stderr, "base128: error reading file:", err)
os.Exit(1)
}
input = string(bytes)
}
Paso a paso :
Comprueba si el usuario ha proporcionado un archivo como argumento.
En caso contrario, lee los datos de la entrada estándar ( stdin).
Si se proporciona un archivo, lee datos del archivo.
